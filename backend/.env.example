# ============================================================
# COPIER CE FICHIER EN ".env" ET REMPLIR LES VALEURS
# Ne jamais committer le fichier .env
# ============================================================

# Clé secrète Django (obligatoire)
SECRET_KEY=change-moi-en-production

# Mode debug (True en dev, False en prod)
DEBUG=True

# Hôtes autorisés (séparés par des virgules)
ALLOWED_HOSTS=localhost,127.0.0.1

# ── Base de données ──────────────────────────────────────────
# Laisser DB_NAME vide → SQLite local (mode développement rapide)
# Remplir DB_NAME → SQL Server (base de données réelle)

DB_NAME=
DB_USER=
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=1433

# ── Email (pour les notifications aux candidats) ─────────────
EMAIL_HOST_USER=
EMAIL_HOST_PASSWORD=
